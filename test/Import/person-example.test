// examples/person/person.mlir is the importer's output for
// person.schema.json, and canonicalizing it gives the IR shown in
// examples/person/README.md.

// RUN: schema-translate --import-json-schema %S/../../examples/person/person.schema.json > %t.mlir
// RUN: diff %t.mlir %S/../../examples/person/person.mlir
// RUN: schema-opt --schema-canonicalize %t.mlir | FileCheck %s

//      CHECK: module {
// CHECK-NEXT:   func.func @validate_person(%arg0: !schema.value, %arg1: !schema.value, %arg2: !schema.value) -> i1 {
// CHECK-NEXT:     %0 = schema.validate_string %arg1 {max_length = 64 : i64, min_length = 1 : i64} : !schema.value
// CHECK-NEXT:     %1 = schema.validate_number %arg2 {exclusive_maximum, integral, maximum = 1.500000e+02 : f64, minimum = 1.800000e+01 : f64} : !schema.value
// CHECK-NEXT:     %2 = schema.struct %arg0 as "Person" fields ["name", "age"] required ["name"] validators(%0, %1) : (!schema.value, i1, i1) -> i1
// CHECK-NEXT:     return %2 : i1
// CHECK-NEXT:   }
// CHECK-NEXT: }
